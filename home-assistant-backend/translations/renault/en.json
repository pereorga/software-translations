    "issues": {
        "account_not_found": {
            "fix_flow": {
                "abort": {
                    "cannot_connect": "Failed to connect",
                    "no_new_account": "No other Kamereon account linked to your vehicles was found. If you already added your vehicles again under a new Renault entry, delete the entry for account {account_id}.",
                    "reauth_required": "Your Renault login is no longer valid. Re-authenticate the Renault integration, then open this repair again."
                },
                "step": {
                    "account": {
                        "data": {
                            "kamereon_account_id": "Account ID"
                        },
                        "data_description": {
                            "kamereon_account_id": "The new Kamereon account ID linked to your vehicles"
                        },
                        "description": "Renault no longer lists the Kamereon account {account_id}, so Home Assistant can't load your vehicles. Renault may have moved your vehicles to a new account.\n\nSelect the new account to keep using your existing devices and entities. The integration is reloaded once you submit.",
                        "title": "Select the new Kamereon account"
                    }
                }
            },
            "title": "Renault account {account_id} no longer exists"
        }
