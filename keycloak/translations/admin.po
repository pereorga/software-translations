#: invalidPasswordMinLengthMessage
msgid "Invalid password: minimum length {0}."
msgstr "La contrasenya no és vàlida: la longitud mínima és {0}."

#: invalidPasswordMaxLengthMessage
msgid "Invalid password: maximum length {0}."
msgstr "La contrasenya no és vàlida: la longitud màxima és {0}."

#: invalidPasswordMinLowerCaseCharsMessage
msgid "Invalid password: must contain at least {0} lower case characters."
msgstr ""
"La contrasenya no és vàlida: ha de contenir almenys {0} lletres minúscules."

#: invalidPasswordMinDigitsMessage
msgid "Invalid password: must contain at least {0} numerical digits."
msgstr ""
"La contrasenya no és vàlida: ha de contenir almenys {0} caràcters numèrics."

#: invalidPasswordMinUpperCaseCharsMessage
msgid "Invalid password: must contain at least {0} upper case characters."
msgstr ""
"La contrasenya no és vàlida: ha de contenir almenys {0} lletres majúscules."

#: invalidPasswordMinSpecialCharsMessage
msgid "Invalid password: must contain at least {0} special characters."
msgstr ""
"La contrasenya no és vàlida: ha de contenir almenys {0} caràcters especials."

#: invalidPasswordNotUsernameMessage
msgid "Invalid password: must not be equal to the username."
msgstr "La contrasenya no és vàlida: no pot ser igual al nom d’usuari."

#: invalidPasswordNotContainsUsernameMessage
msgid "Invalid password: Can not contain the username."
msgstr "La contrasenya no és vàlida: no pot contenir el nom d’usuari."

#: invalidPasswordNotEmailMessage
msgid "Invalid password: must not be equal to the email."
msgstr "La contrasenya no és vàlida: no pot ser igual al correu electrònic."

#: invalidPasswordRegexPatternMessage
msgid "Invalid password: fails to match regex pattern(s)."
msgstr ""
"La contrasenya no és vàlida: no coincideix amb els patrons de l’expressió "
"regular."

#: invalidPasswordHistoryMessage
msgid "Invalid password: must not be equal to any of last {0} passwords."
msgstr ""
"La contrasenya no és vàlida: no pot ser igual a les últimes {0} contrasenyes."

#: invalidPasswordBlacklistedMessage
msgid "Invalid password: password is not allowed."
msgstr "La contrasenya no és vàlida: la contrasenya no és permesa."

#: invalidPasswordGenericMessage
msgid "Invalid password: new password does not match password policies."
msgstr ""
"La contrasenya no és vàlida: la contrasenya nova no coincideix amb les "
"polítiques de contrasenya."

#: ldapErrorEditModeMandatory
msgid "Edit Mode is mandatory"
msgstr "El mode d’edició és requerit"

#: ldapErrorInvalidCustomFilter
msgid ""
"Custom configured LDAP filter does not start with \"(\" or does not end with "
"\")\"."
msgstr ""
"El filtre d’LDAP personalitzat configurat no comença per «(» o no acaba amb "
"«)»."

#: ldapErrorConnectionTimeoutNotNumber
msgid "Connection Timeout must be a number"
msgstr "El temps d’espera de la connexió ha de ser un número"

#: ldapErrorReadTimeoutNotNumber
msgid "Read Timeout must be a number"
msgstr "El temps d’espera de la lectura ha de ser un número"

#: ldapErrorMissingClientId
msgid ""
"Client ID needs to be provided in config when Realm Roles Mapping is not "
"used."
msgstr ""
"S’ha de proveir un ID de client a la configuració quan el mapatge de rols "
"del domini no està en ús."

#: ldapErrorCantPreserveGroupInheritanceWithUIDMembershipType
msgid ""
"Not possible to preserve group inheritance and use UID membership type "
"together."
msgstr ""
"No és possible preservar l’herència de grups i alhora utilitzar el tipus de "
"pertinença UID."

#: ldapErrorCantWriteOnlyForReadOnlyLdap
msgid "Can not set write only when LDAP provider mode is not WRITABLE"
msgstr ""
"No es pot establir el mode només escriptura quan el mode del proveïdor LDAP "
"no és «WRITABLE»"

#: ldapErrorCantWriteOnlyAndReadOnly
msgid "Can not set write-only and read-only together"
msgstr "No es pot establir només escriptura i només lectura alhora"

#: ldapErrorCantEnableStartTlsAndConnectionPooling
msgid "Can not enable both StartTLS and connection pooling."
msgstr ""
"No es pot habilitar el StartTLS i la disponibilitat de connexions alhora."

#: ldapErrorCantEnableUnsyncedAndImportOff
msgid "Can not disable Importing users when LDAP provider mode is UNSYNCED"
msgstr ""
"No es pot inhabilitar la importació d’usuaris quan el mode del proveïdor "
"LDAP és «UNSYNCED»"

#: ldapErrorMissingGroupsPathGroup
msgid ""
"Groups path group does not exist - please create the group on specified path "
"first"
msgstr ""
"El grup de camins de grup no existeix. Creeu el grup al camí especificat "
"primer"

#: ldapErrorValidatePasswordPolicyAvailableForWritableOnly
msgid "Validate Password Policy is applicable only with WRITABLE edit mode"
msgstr ""
"La política de validació de contrasenyes només és aplicable amb el mode d’"
"edició «WRITABLE»"

#: ldapErrorConnectionUrlContainsComma
msgid ""
"Connection URL must not contain commas. Use spaces to separate multiple LDAP "
"URLs (e.g. \"ldap://host1:389 ldap://host2:389\")."
msgstr ""
"L’URL de connexió no ha de contenir comes. Utilitzeu espais per a separar "
"diversos URL LDAP (per ex., \"ldap://host1:389 ldap://host2:389\")."

#: ldapErrorInvalidConnectionUrl
msgid "Connection URL contains an invalid LDAP URL."
msgstr "L’URL de connexió conté una URL LDAP invàlida."

#: ldapErrorInvalidConnectionUrlScheme
msgid ""
"Connection URL contains a URL with an unsupported scheme. Each URL must use "
"the ldap:// or ldaps:// scheme."
msgstr ""
"L’URL de connexió conté un URL amb un esquema no implementat. Cada URL ha d’"
"utilitzar l’esquema ldap:// o ldaps://."

#: clientRedirectURIsFragmentError
msgid "A redirect URI must not contain an URL fragment"
msgstr "Un URI de redirecció no ha de contenir un fragment d’URL"

#: clientPostLogoutRedirectURIsFragmentError
msgid "A post-logout redirect URI must not contain an URL fragment"
msgstr ""
"Un URI de redirecció post-tancament de sessió no ha de contenir un fragment "
"d’URL"

#: clientRootURLFragmentError
msgid "Root URL must not contain an URL fragment"
msgstr "L’URL arrel no ha de contenir un fragment d’URL"

#: clientRootURLIllegalSchemeError
msgid "Root URL uses an illegal scheme"
msgstr "L’URL arrel utilitza un esquema il·legal"

#: clientBaseURLIllegalSchemeError
msgid "Base URL uses an illegal scheme"
msgstr "L’URL base utilitza un esquema il·legal"

#: backchannelLogoutUrlIllegalSchemeError
msgid "Backchannel logout URL uses an illegal scheme"
msgstr "L’URL de desconnexió del canal posterior utilitza un esquema il·legal"

#: clientRedirectURIsIllegalSchemeError
msgid "A redirect URI uses an illegal scheme"
msgstr "Un URI de redirecció utilitza un esquema il·legal"

#: clientPostLogoutRedirectURIsIllegalSchemeError
msgid "A post-logout redirect URI uses an illegal scheme"
msgstr ""
"Un URI de redirecció post-tancament de sessió utilitza un esquema il·legal"

#: clientBaseURLInvalid
msgid "Base URL is not a valid URL"
msgstr "L’URL base no és un URL vàlid"

#: clientRootURLInvalid
msgid "Root URL is not a valid URL"
msgstr "L’URL arrel no és un URL vàlid"

#: clientRedirectURIsInvalid
msgid "A redirect URI is not a valid URI"
msgstr "Un URI de redirecció no és un URI vàlid"

#: clientPostLogoutRedirectURIsInvalid
msgid "A post-logout redirect URI is not a valid URI"
msgstr "Un URI de redirecció post-tancament de sessió no és un URI vàlid"

#: backchannelLogoutUrlIsInvalid
msgid "Backchannel logout URL is not a valid URL"
msgstr "L’URL de desconnexió del canal posterior no és un URL vàlid"

#: pairwiseMalformedClientRedirectURI
msgid "Client contained an invalid redirect URI."
msgstr "El client conté un URI de redirecció no vàlid."

#: pairwiseClientRedirectURIsMissingHost
msgid "Client redirect URIs must contain a valid host component."
msgstr ""
"Els URI de redirecció de client han de contenir un component de servidor "
"vàlid."

#: pairwiseClientRedirectURIsMultipleHosts
msgid ""
"Without a configured Sector Identifier URI, client redirect URIs must not "
"contain multiple host components."
msgstr ""
"Sense un URI d’identificador de sector, els URI de redirecció de client no "
"poden contenir múltiples components de servidor."

#: pairwiseMalformedSectorIdentifierURI
msgid "Malformed Sector Identifier URI."
msgstr "L’URI d’identificador de sector està mal formatat."

#: pairwiseFailedToGetRedirectURIs
msgid "Failed to get redirect URIs from the Sector Identifier URI."
msgstr ""
"No s’ha pogut obtenir cap URI de redirecció des de l’URI d’identificador de "
"sector."

#: pairwiseRedirectURIsMismatch
msgid ""
"Client redirect URIs does not match redirect URIs fetched from the Sector "
"Identifier URI."
msgstr ""
"Els URI de redirecció de client no concorden amb els URI de redirecció "
"obtinguts des de l’URI d’identificador de sector."

#: duplicatedJwksSettings
msgid ""
"The \"Use JWKS\" switch and the switch \"Use JWKS URL\" cannot be ON at the "
"same time."
msgstr ""
"Els commutadors «Utilitza JWKS» i «Utilitza un URL JWKS» no poden estar "
"habilitats al mateix temps."

#.
#. Shown to an admin when they enter a client specific SSO idle timeout that fails validation
#: clientIdleExceedsRealmRememberMeIdle
msgid ""
"Client session idle timeout cannot exceed realm SSO session idle timeout and "
"RememberMe idle timeout."
msgstr ""
"El temps d’inactivitat de la sessió del client no pot excedir l’hora d’"
"inactivitat de la sessió SSO i Recorda’m."

#. Shown to an admin when they enter a client specific SSO idle timeout that fails validation
#: clientSessionIdleTimeoutExceedsRealm
msgid ""
"Client session idle timeout cannot exceed realm SSO session idle timeout."
msgstr ""
"El temps d’inactivitat de la sessió del client no pot superar el temps d’"
"inactivitat de la sessió SSO."

#. Shown to an admin when they enter a client specific SSO max lifetime that fails validation
#: clientSessionMaxLifespanExceedsRealm
msgid ""
"Client session max lifespan cannot exceed realm SSO session max lifespan."
msgstr ""
"La durada màxima de la sessió del client no pot superar la durada màxima de "
"la sessió SSO."

#. Shown to an admin when they enter a client specific SSO max lifetime that fails validation
#: clientSessionMaxLifespanExceedsRealmRememberMeMaxSpan
msgid ""
"Client session max lifespan cannot exceed realm SSO session max lifespan and "
"RememberMe Max span."
msgstr ""
"La durada màxima de la sessió del client no pot superar la durada màxima de "
"les sessions SSO i Recorda’m."

#: error-invalid-value
msgctxt "error-invalid-value"
msgid "Invalid value."
msgstr "El valor no és vàlid."

#: error-invalid-blank
msgctxt "error-invalid-blank"
msgid "Please specify value."
msgstr "Especifiqueu un valor."

#: error-empty
msgctxt "error-empty"
msgid "Please specify value."
msgstr "Especifiqueu un valor."

#: error-invalid-length
msgid "Attribute {0} must have a length between {1} and {2}."
msgstr "L’atribut {0} ha de tenir una llargària d’entre {1} i {2}."

#: error-invalid-length-too-short
msgid "Attribute {0} must have minimal length of {1}."
msgstr "L’atribut {0} ha de tenir una llargària de, com a mínim, {1}."

#: error-invalid-length-too-long
msgid "Attribute {0} must have maximal length of {2}."
msgstr "L’atribut {0} ha de tenir una llargària de, com a màxim, {2}."

#: error-invalid-email
msgid "Invalid email address."
msgstr "L’adreça de correu electrònic no és vàlida."

#: error-invalid-number
msgid "Invalid number."
msgstr "El nombre no és vàlid."

#: error-number-out-of-range
msgid "Attribute {0} must be a number between {1} and {2}."
msgstr "L’atribut {0} ha de ser un número entre {1} i {2}."

#: error-number-out-of-range-too-small
msgid "Attribute {0} must have minimal value of {1}."
msgstr "L’atribut {0} ha de tenir un valor de, com a mínim, {1}."

#: error-number-out-of-range-too-big
msgid "Attribute {0} must have maximal value of {2}."
msgstr "L’atribut {0} ha de tenir un valor de, com a màxim, {2}."

#: error-pattern-no-match
msgctxt "error-pattern-no-match"
msgid "Invalid value."
msgstr "El valor no és vàlid."

#: error-invalid-uri
msgid "Invalid URL."
msgstr "L’URL no és vàlid."

#: error-invalid-uri-scheme
msgid "Invalid URL scheme."
msgstr "L’esquema d’URL no és vàlid."

#: error-invalid-uri-fragment
msgid "Invalid URL fragment."
msgstr "El fragment d’URL no és vàlid."

#: error-user-attribute-required
msgid "Please specify attribute {0}."
msgstr "Especifiqueu l’atribut {0}."

#: error-invalid-date
msgid "Attribute {0} is invalid date."
msgstr "L’atribut {0} és una data invàlida."

#: error-user-attribute-read-only
msgid "Attribute {0} is read only."
msgstr "L’atribut {0} és només de lectura."

#: error-username-invalid-character
msgctxt "error-username-invalid-character"
msgid "{0} contains invalid character."
msgstr "{0} conté un caràcter no vàlid."

#: error-person-name-invalid-character
msgctxt "error-person-name-invalid-character"
msgid "{0} contains invalid character."
msgstr "{0} conté un caràcter no vàlid."

#: error-invalid-multivalued-size
msgid ""
"Attribute {0} must have at least {1} and at most {2} "
"{2,choice,0#values|1#value|1<values}."
msgstr ""
"L’atribut {0} ha de tenir almenys {1} i com a molt {2} "
"{2,choice,0#valors|1#valor|1<valors}."

#: error-non-ascii-local-part-email
msgid "Local part of the address must contain only ASCII characters."
msgstr "La part local de l’adreça ha de contenir només caràcters ASCII."

#: workflowSingleRestartStepOnly
msgid "Workflow can have only one restart step."
msgstr "El flux de treball només pot tenir un pas de reinici."

#: workflowRestartStepMustBeLast
msgid "Workflow restart step must be the last step."
msgstr "El pas de reinici al flux de treball ha de ser l’últim."

#: workflowRestartStepInvalidPosition
msgid "Workflow restart step has invalid position: {0}."
msgstr "El pas de reinici al flux de treball té una posició no vàlida: {0}."

#: workflowNoScheduledStepAtPosition
msgid "No scheduled step found if restarting at position {0}."
msgstr "No s’ha trobat cap pas programat si es reinicia a la posició {0}."

#: workflowInvalidType
msgid "Invalid workflow type: {0}."
msgstr "Tipus de flux de treball no vàlid: {0}."

#: workflowConditionTypesIncompatible
msgid ""
"Provided condition types ({0}) are not compatible with workflow type ({1})."
msgstr ""
"Els tipus de condició proporcionats ({0}) no són compatibles amb el tipus de "
"flux de treball ({1})."

#: workflowStepUsesRequired
msgid "Step ''uses'' cannot be null or empty."
msgstr "El pas «utilitza» no pot ser «null» o buit."

#: workflowStepAfterNegative
msgid "Step ''after'' configuration cannot be negative."
msgstr "El pas «després» de la configuració no pot ser negatiu."

#: workflowStepAfterInvalid
msgid "Step ''after'' configuration is not valid: {0}."
msgstr "El pas «després» de la configuració no és vàlid: {0}."

#: workflowStepProviderNotFound
msgid "Could not find step provider: {0}."
msgstr "No s’ha pogut trobar el proveïdor del pas: {0}."

#: workflowNameEmpty
msgid "Workflow name cannot be null or empty."
msgstr "El nom del flux de treball no pot ser «null» o buit."

#: workflowNameDuplicate
msgid ""
"Workflow name must be unique. A workflow with name ''{0}'' already exists."
msgstr ""
"El nom del flux de treball ha de ser únic. Ja existeix un flux amb el nom "
"«{0}»."

#: workflowCannotUpdateOnWithScheduled
msgid ""
"Cannot update ''on'' configuration when there are scheduled resources for "
"the workflow."
msgstr ""
"No es pot actualitzar la configuració «actiu» quan hi ha recursos programats "
"per al flux de treball."

#: workflowCannotUpdateSupports
msgid "Cannot update ''supports'' configuration."
msgstr "No es pot actualitzar la configuració «és compatible amb»."

#: workflowCannotChangeStepsWithScheduled
msgid ""
"Cannot change the number or order of steps when there are scheduled "
"resources for the workflow."
msgstr ""
"No es pot canviar el nombre o l’ordre de passos quan hi ha recursos "
"programats per al flux de treball."

#: workflowMigrateDifferentTypes
msgid ""
"Cannot migrate scheduled resources between workflows that support different "
"resource types."
msgstr ""
"No es poden migrar els recursos programats entre fluxos de treball que són "
"compatibles amb tipus de recursos diferents."

#: workflowMigrateConditionsNotMet
msgid ""
"Cannot migrate resource {0} to workflow {1} as it does not satisfy the "
"workflow''s activation conditions."
msgstr ""
"No es pot migrar el recurs {0} al flux de treball {1} perquè no compleix amb "
"les condicions d’activació del flux de treball."

#: workflowResourceTypeNotSupported
msgid ""
"Resource type ''{0}'' is not supported for this workflow (supports {1})."
msgstr ""
"El tipus de recurs «{0}» no és compatible amb aquest flux de treball (és "
"compatible amb {1})."

#: workflowInvalidResource
msgid "Not a valid workflow resource: {0}."
msgstr "No és un recurs del flux de treball vàlid: {0}."

#: workflowStepsIncompatible
msgid "Steps provided are not compatible with each other."
msgstr "Els passos proporcionats no són compatibles entre ells."

#: workflowStepsSingleTypeRequired
msgid "Steps provided should support a single type, actual: {0}."
msgstr ""
"Els passos proporcionats haurien de ser compatibles amb un sol tipus, actual:"
" {0}."

#: workflowNotFoundById
msgid "Workflow with id ''{0}'' not found."
msgstr "No s’ha trobat el flux de treball amb ID «{0}»."

#: workflowResourceNotFound
msgid "Resource with id {0} not found."
msgstr "No s’ha trobat el recurs amb ID {0}."

#: workflowMigrateStepIdsRequired
msgid "Both ''from'' and ''to'' step ids must be provided for migration."
msgstr ""
"Cal proporcionar els ID dels passos «des de» i «cap a» per a fer la migració."

#: workflowProviderFactoryNotFound
msgid "Could not find provider factory with id: {0}."
msgstr "No s’ha trobat la fàbrica de proveïdors amb id: {0}."

#: workflowConditionRoleNotSet
msgid "Expected role name not set."
msgstr "No s’ha definit el nom del rol."

#: workflowConditionRoleNotFound
msgid "Role with name {0} does not exist."
msgstr "No existeix cap rol amb el nom {0}."

#: workflowConditionGroupNotSet
msgid "Expected group path not set."
msgstr "No s’ha definit la ruta del grup."

#: workflowConditionGroupNotFound
msgid "Group with name {0} does not exist."
msgstr "No existeix cap grup amb el nom {0}."

#: workflowConditionIdpNotSet
msgid "Expected identity provider alias is not set."
msgstr "No s’ha definit l’àlies del proveïdor d’identitat."

#: workflowConditionIdpNotFound
msgid "Identity provider {0} does not exist."
msgstr "No existeix el proveïdor d’identitat {0}."

#: workflowConditionAttributeNotSet
msgid "Expected ''key:value'' pair is not set."
msgstr "El parell «clau:valor» que s''esperava no està definit."

#: workflowConditionAttributeInvalid
msgid "Error reading key-value pair {0}. Expected format ''key:value''."
msgstr ""
"Error en llegir el parell «clau-valor» {0}. El format esperat és "
"«clau:valor»."

#: workflowExpressionEmpty
msgid "Expression cannot be null or empty."
msgstr "L’expressió no pot ser «null» o buida."

#: workflowExpressionMaxLength
msgid "Expression exceeds maximum allowed length of {0} characters."
msgstr "L’expressió excedeix el nombre màxim de caràcters, que és {0}."

#: workflowExpressionMaxDepth
msgid "Expression exceeds maximum allowed nesting depth of {0}."
msgstr ""
"L’expressió excedeix la profunditat màxima d’imbricació permesa, que és {0}."

#: workflowExpressionInvalid
msgid ""
"Invalid expression: {0}\n"
"Error details:\n"
"{1}"
msgstr ""
"Expressió no vàlida: {0}\n"
"Detalls de l’error:\n"
"{1}"

#: client_account
msgid "Account"
msgstr "Compte"

#: client_account-console
msgid "Account Console"
msgstr "Consola del compte"

#: client_security-admin-console
msgid "Security Admin Console"
msgstr "Consola d’administració de seguretat"

#: client_admin-cli
msgid "Admin CLI"
msgstr "CLI d’administració"

#: client_realm-management
msgid "Realm Management"
msgstr "Gestió del domini"

#: client_broker
msgid "Broker"
msgstr "Agent"
